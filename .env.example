# 每日精读「内容流水线」本地配置模板
# 用法：cp .env.example .env  然后填入真实 key（.env 已被 .gitignore 忽略，切勿提交）
#
# 注意：只有「生成讲义解析」需要 key；纯抓稿（--dry-run）不需要。
# GitHub Actions 每日自动上新时，请在仓库 Settings → Secrets and variables → Actions 配置，不要写进这里。

# 必填：DeepSeek API Key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：模型名，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# 可选：自定义 OpenAI 兼容端点
# DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions

# 可选：主模型失败时的回退（Gemini）
# GEMINI_API_KEY=
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-2.5-flash

# 可选：当天无结构达标文章时向前回溯几期，默认 5，0 表示关闭
# ESSAY_LOOKBACK_DAYS=5

# 可选：限定每日抓稿来源（逗号分隔），留空=全部 6 个官媒源
# 可选 id：rmrb,people_opinion,rmlt,gmw,ce,12371
# DAILY_SOURCES=rmrb,rmlt,gmw,ce

# 可选：多环境时用其它配置文件路径（环境变量，不是写在文件里）
# DAILY_DOTENV_PATH=/path/to/another.env
